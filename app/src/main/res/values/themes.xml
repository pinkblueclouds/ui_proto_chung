<resources>

    <style name="Theme.Ui_proto_original" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Date & Weekday Text Sizes -->
    <style name="LargeCalendarDates" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LargeCalendarWeekdays" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- CALENDAR THEME -->
    <style name="CalendarTheme" parent="ThemeOverlay.AppCompat.Light">
        <!-- Light Green Circle Highlight -->
        <item name="colorAccent">@color/light_green</item>
        <item name="android:colorAccent">@color/light_green</item>
        <item name="colorControlActivated">@color/light_green</item>
    </style>

</resources>